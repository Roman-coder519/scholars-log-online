{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "pnpm run build:web && pnpm run build:api",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/scholars-log run dev",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:web": "pnpm --filter @workspace/scholars-log run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:import": "node lib/db/scripts/import-data.mjs development-data-export.json"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
